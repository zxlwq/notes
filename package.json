{
  "name": "notes",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,vite -c blue,green \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite",
    "dev:server": "node --env-file=.env server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/index.js",
    "type-check": "tsc --noEmit",
    "type-check:js": "tsc --noEmit -p tsconfig.js.json",
    "lint": "eslint . --no-cache",
    "lint:fix": "eslint . --fix --no-cache",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:css:fix": "stylelint \"src/**/*.css\" --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "parity:check": "node scripts/parity.js",
    "test:markdown": "tsx --tsconfig tsconfig.json scripts/markdown-check.ts",
    "deploy:cron": "cd workers/log-cron && wrangler deploy",
    "check": "npm run type-check && npm run type-check:js && npm run lint && npm run lint:css && npm run format:check && npm run parity:check && npm run test:markdown"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.9.5",
    "axios": "^1.21.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.0.0",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.3",
    "highlight.js": "^11.11.1",
    "lucide-react": "^0.263.1",
    "mdast-util-to-string": "^4.0.0",
    "mermaid": "^12.3.0",
    "pg": "^8.11.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^9.0.0",
    "react-router-dom": "^7.18.2",
    "react-simplemde-editor": "^5.0.0",
    "rehype-highlight": "^7.0.2",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-highlight-mark": "^1.4.0",
    "remark-parse": "^11.0.0",
    "serve-static": "^1.15.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/node": "^24.8.1",
    "@types/pg": "^8.10.9",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.16",
    "concurrently": "^10.0.7",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-tailwindcss": "^3.18.3",
    "globals": "^17.6.0",
    "playwright": "^1.55.1",
    "postcss": "^8.4.32",
    "prettier": "^3.8.4",
    "rehype-stringify": "^10.0.1",
    "remark-rehype": "^11.1.2",
    "stylelint": "^17.13.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-tailwindcss": "^1.0.1",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.4.0",
    "vite": "^7.3.7",
    "vite-plugin-pwa": "^1.3.0"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "body-parser": "^1.20.9",
    "brace-expansion@1": "1.1.21",
    "brace-expansion@2": "2.1.7",
    "dompurify": "^3.4.17",
    "deepmerge": "4.1.2",
    "fast-uri": "^3.1.9",
    "follow-redirects": "^1.16.2",
    "glob": "^14.0.4",
    "ip-address": "^10.7.6",
    "minimatch@9": "^11.0.5",
    "minimatch@10": "^11.0.5",
    "postcss-selector-parser@6": "6.1.5",
    "postcss-selector-parser@7": "7.1.7",
    "proxy-addr": "^2.0.8",
    "qs": "^6.17.1",
    "serialize-javascript": "^7.1.4",
    "shell-quote": "^1.12.0",
    "source-map-js": "^1.2.2",
    "sucrase": "3.35.1",
    "zod": "^4.6.7",
    "source-map-support": {
      "source-map": "0.6.1"
    },
    "workbox-build": {
      "source-map": "0.8.0"
    }
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
