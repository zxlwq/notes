# =============================================================================
# 必填
# =============================================================================

# 登录密码（必填）
PASSWORD=123456

# JWT 签名密钥（生产必填，与 PASSWORD 独立；本地开发可省略）
JWT_SECRET=your-random-secret-key

# 数据库连接（Cloudflare D1 部署无需此项，改为在 Pages 绑定 NOTESD）
# 若在 Cloudflare Pages 同时配置 DATABASE_URL，将把 D1 笔记/设置/排序异步同步至 PostgreSQL，便于迁移到 Vercel / Docker 等平台
DATABASE_URL=postgresql://username:password@host:port/database

# =============================================================================
# 可选
# =============================================================================

# 会话有效期（秒，默认 604800 = 7 天）；Cookie 为 SameSite=Strict + HttpOnly
# SESSION_TTL_SEC=86400

# 生产 CORS 白名单（逗号分隔）。未设置时回显请求 Origin；无 Origin 则 *
# ALLOWED_ORIGINS=https://notes.example.com

# Express / Pages Functions 日志保留天数（默认 7）
LOG_RETENTION_DAYS=7

# Cron 清理端点密钥（Vercel Cron、Cloudflare Worker / EdgeOne → GET/POST /api/cron/logs）
# 生产建议设置；未设置时端点不校验 Authorization
# EdgeOne 平台 schedules 无法带 Bearer：设 TOKEN 后需外部 Cron，或 EdgeOne 部署可不设
# TOKEN=your-random-cron-secret

# Edge Functions 调试日志（生产环境留空；开发可设 true）
# DEBUG=true
# ENVIRONMENT=development

# =============================================================================
# 备份（可选）
# =============================================================================

# WebDAV 备份
WEBDAV_URL=https://notes.example.com/dav/
WEBDAV_USER=admin
WEBDAV_PASS=123456

# GitHub Gist 备份
GIT_TOKEN=github_token

# 其它平台Cloudflare R2存储桶备份
ACCOUNT_ID=your_account_id
ACCESS_KEY_ID=AccessKeyID
SECRET_ACCESS_KEY=SecretAccessKey

# =============================================================================
# 平台说明
# =============================================================================
# Vercel/EdgeOne/Docker容器平台  → 需要 PASSWORD + DATABASE_URL
# Cloudflare Pages     → 需要PASSWORD + 绑定D1数据库（NOTESD）；可选DATABASE_URL同步至PostgreSQL
# Cloudflare Pages     → Service Binding LOG_CRON → notes-log-cron Worker
# Cloudflare R2 备份   → 在Pages绑定R2存储桶（NOTESR）

# =============================================================================
# AI 提供商
# =============================================================================

# OpenAI 兼容接口（支持 OpenAI 兼容接口的 AI 提供商，例如 OpenRouter）
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://openrouter.ai/api/v1"
# OPENAI_MODEL_NAME: 模型名称（多个用英文逗号分隔，可在 AI 面板切换）
OPENAI_MODEL_NAME=""

# ARK_API_KEY: 火山方舟 API Key
ARK_API_KEY=""
# ARK_BASE_URL: 火山方舟 API 基础地址
ARK_BASE_URL="https://ark.cn-beijing.volces.com/api/v3"
# ARK_MODEL_NAME: 火山方舟模型名称（多个用英文逗号分隔，可在 AI 面板切换）
ARK_MODEL_NAME=""

# KILO_API_KEY: Kilo Code API Key
KILO_API_KEY=""
# KILO_BASE_URL: Kilo Code API 基础地址
KILO_BASE_URL="https://api.kilo.ai/api/gateway"
# KILO_MODEL_NAME: Kilo Code 模型名称（多个用英文逗号分隔，可在 AI 面板切换）
KILO_MODEL_NAME=""

# CF_API_KEY: Cloudflare Workers AI API Token（REST 回退；Pages 已绑定 Workers AI 变量 AI 时可省略）
CF_API_KEY=""
# CF_ACCOUNT_ID: Cloudflare 帐户 ID（REST 回退必填；已绑定 AI 时可省略）
CF_ACCOUNT_ID=""
# CF_MODEL_NAME: Workers AI 模型 ID（绑定与 REST 均必填；多个用英文逗号分隔，可在 AI 面板切换）
CF_MODEL_NAME=""

# ZHIPU_API_KEY: 智谱 AI API Key
ZHIPU_API_KEY=""
# ZHIPU_BASE_URL: 智谱 AI API 基础地址
ZHIPU_BASE_URL="https://open.bigmodel.cn/api/paas/v4"
# ZHIPU_MODEL_NAME: 智谱 AI 模型名称（多个用英文逗号分隔，可在 AI 面板切换）
ZHIPU_MODEL_NAME=""

# GH_API_KEY: GitHub Personal Access Token（需 models:read 权限）
GH_API_KEY=""
# GH_BASE_URL: GitHub Models API 基础地址
GH_BASE_URL="https://models.github.ai/inference"
# GH_MODEL_NAME: GitHub Models 模型名称（多个用英文逗号分隔，可在 AI 面板切换）
GH_MODEL_NAME=""

# 启用的 AI 提供商白名单（openai | ark | kilo | cf | zhipu | gh）；留空=全部已配置项可在面板切换；多个用逗号或 | 分隔，列表中第一个为默认
AI_PROVIDER=

# AI 请求限流：每 IP 每窗口最大次数（默认 20）/ 窗口秒数（默认 3600）
AI_RATE_LIMIT_MAX=20
AI_RATE_LIMIT_WINDOW_SEC=3600

# 单次请求正文最大字符数（默认 32000）
AI_MAX_INPUT_CHARS=32000